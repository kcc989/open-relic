{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit generates a `migrations.js` per Durable Object under
    // `apps/api/drizzle/`; reading them is what types the migration bundles the
    // objects apply.
    "allowJs": true
  },
  "include": [
    "alchemy.run.ts",
    "drizzle.config.ts",
    "drizzle.repository.config.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/types/**/*.d.ts",
    "apps/*/drizzle/**/*.js",
    "packages/*/src/**/*.ts"
  ]
}
