# Cloudflare credentials for Alchemy.
#
# Local development can skip this file entirely by running `bun alchemy login`,
# which stores an OAuth profile in ~/.alchemy/profiles.json. Use these variables
# instead when you want a scoped API token (CI, shared machines, containers).
#
# The token needs: Workers Scripts:Edit, Workers Subdomain:Edit,
# Workers Observability:Edit, and Account Settings:Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Accept pushes from anyone who can reach the installation. The Git protocol has
# no credentials yet, so this is the only way to enable it — and anything but
# "true", including leaving it unset, refuses every push. Repo-scoped tokens
# replace it.
ALLOW_ANONYMOUS_WRITE=
