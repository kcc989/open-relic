{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit generates a `migrations.js` per Durable Object under
    // `drizzle/`; reading them is what types the migration bundles the objects
    // apply.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts", "drizzle/**/*.js"]
}
