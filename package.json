{
  "name": "open-relic",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun test",
    "deploy": "bun alchemy deploy",
    "deploy:prod": "bun alchemy deploy --stage prod",
    "dev": "bun alchemy dev",
    "destroy": "bun alchemy destroy",
    "plan": "bun alchemy plan",
    "plan:prod": "bun alchemy plan --stage prod",
    "tail": "bun alchemy tail",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "@types/bun": "^1.2.7",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.108",
    "typescript": "^5.9.2"
  },
  "packageManager": "bun@1.2.7"
}
